# ── Moon Club — variables de entorno ─────────────────────────────
# NUNCA subas el archivo .env real al repositorio.

# Backend (Supabase / Lovable Cloud)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=solo-en-el-servidor

# Frontend (visible en el navegador — solo claves públicas)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Discord OAuth2 — https://discord.com/developers/applications
# Redirect URI: https://TU-DOMINIO/api/public/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Roblox OAuth 2.0 — https://create.roblox.com/dashboard/credentials
# Redirect URI: https://TU-DOMINIO/api/public/auth/roblox/callback
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# ID numérico de Discord del propietario (djmikami)
OWNER_DISCORD_ID=
